        "query": "with entrada as (\n    select\n        $1::text as texto_normalizado,\n        $2::text as texto_original,\n        $3::text as titulo,\n        $4::text as tema,\n        $5::text as fuente\n),\nexistente as (\n    select\n        id,\n        titulo,\n        tema,\n        fuente,\n        estado,\n        numero_chunks\n    from public.materiales_docentes\n    where md5(texto_normalizado) = md5($1::text)\n    order by id desc\n    limit 1\n)\nselect\n    e.*,\n    (x.id is not null) as duplicado,\n    x.id as material_existente_id,\n    x.titulo as material_existente_titulo,\n    x.estado as material_existente_estado,\n    x.numero_chunks as material_existente_chunks\nfrom entrada e\nleft join existente x on true;",
