        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ (() => {\n  const estado = $json.estado;\n\n  let actividad = null;\n\n  if ($json.contenido) {\n    const raw = typeof $json.contenido === 'string'\n      ? JSON.parse($json.contenido)\n      : $json.contenido;\n\n    actividad = raw?.output?.output ?? raw?.output ?? raw;\n  }\n\n  return {\n    ok: true,\n    solicitud_id: $json.solicitud_id,\n    estado,\n    actividad_id: $json.actividad_id\n      ? Number($json.actividad_id)\n      : null,\n    mensaje: $json.mensaje ?? null,\n    regenerada: Number($json.regeneraciones ?? 0) > 0,\n    actividad\n  };\n})() }}",
        "options": {
          "responseCode": 200
        }
