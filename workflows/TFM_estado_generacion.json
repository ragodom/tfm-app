    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n    s.id as solicitud_id,\n    s.estado,\n    s.actividad_id,\n    s.mensaje,\n    s.creado_en,\n    s.actualizado_en,\n    a.contenido,\n    a.regeneraciones\nfrom public.solicitudes_generacion s\nleft join public.actividades a\n    on a.id = s.actividad_id\nwhere s.id = $1::uuid\nlimit 1;",
        "options": {
          "queryReplacement": "={{ $('Webhook - Estado generación').first().json.query.solicitud_id }}"
