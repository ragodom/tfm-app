    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n  coalesce(\n    json_agg(\n      json_build_object(\n        'id', id,\n        'nombre', nombre,\n        'intereses', intereses,\n        'aficiones', aficiones,\n        'preferencias', preferencias,\n        'perfil_completo', perfil_completo,\n        'creado_en', creado_en\n      )\n      order by nombre\n    ),\n    '[]'::json\n  ) as perfiles\nfrom public.perfiles;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        448,
        -96
      ],
      "id": "f7af80a5-e950-47a1-8e88-bebe7a823a4a",
      "name": "Listar perfiles",
      "credentials": {
