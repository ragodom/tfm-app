    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  \"ok\": true,\n  \"mensaje\": \"El perfil se ha creado correctamente.\",\n  \"perfil\": {\n    \"id\": Number($json.id),\n    \"nombre\": $json.nombre,\n    \"intereses\": $json.intereses,\n    \"aficiones\": $json.aficiones,\n    \"preferencias\": $json.preferencias,\n    \"perfil_completo\": $json.perfil_completo,\n    \"creado_en\": $json.creado_en\n  }\n} }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        672,
        96
      ],
      "id": "0e0dd0f6-3935-4204-8cda-88f8a0744759",
      "name": "Respuesta - Perfil creado"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into public.perfiles (\n  nombre,\n  intereses,\n  aficiones,\n  preferencias,\n  perfil_completo\n)\nvalues (\n  $1,\n  $2,\n  $3,\n  $4,\n  case\n    when trim(coalesce($2::text, '')) <> ''\n     and trim(coalesce($3::text, '')) <> ''\n     and trim(coalesce($4::text, '')) <> ''\n    then true\n    else false\n  end\n)\nreturning *;",
        "options": {
          "queryReplacement": "={{ [   $json.body.nombre,   $json.body.intereses ?? '',   $json.body.aficiones ?? '',   $json.body.preferencias ?? '' ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
